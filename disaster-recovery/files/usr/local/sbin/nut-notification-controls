#!/usr/bin/env python3

import json
import os
import sys
import tempfile
from pathlib import Path

CONFIG = Path(
    "/etc/nut/config.d/notification-controls.json"
)

DEFAULTS = {
    "daily_health_email": True,
    "weather_based_closing_thoughts": True,
    "telegram_push_notifications": True,
    "telegram_daily_health_push": True,
    "telegram_critical_power_alerts": True,
    "telegram_heartbeat": True,
}


def load():
    data = dict(DEFAULTS)

    try:
        incoming = json.loads(
            CONFIG.read_text(
                encoding="utf-8"
            )
        )

        if isinstance(incoming, dict):
            for key in DEFAULTS:
                if key in incoming:
                    data[key] = bool(
                        incoming[key]
                    )

    except Exception:
        pass

    return data


def save(data):
    st = os.stat(CONFIG)

    fd, tmp = tempfile.mkstemp(
        prefix=".notification-controls-",
        dir=str(CONFIG.parent),
        text=True,
    )

    try:
        with os.fdopen(
            fd,
            "w",
            encoding="utf-8"
        ) as handle:
            json.dump(
                data,
                handle,
                indent=2,
                sort_keys=True
            )
            handle.write("\n")

        os.chmod(
            tmp,
            st.st_mode & 0o777
        )

        os.chown(
            tmp,
            st.st_uid,
            st.st_gid
        )

        os.replace(
            tmp,
            CONFIG
        )

    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def emit(obj, rc=0):
    print(
        json.dumps(
            obj,
            indent=2,
            sort_keys=True
        )
    )
    raise SystemExit(rc)


def main():
    if len(sys.argv) < 2:
        emit({
            "ok": False,
            "error": "missing action"
        }, 2)

    action = sys.argv[1]

    if action == "list":
        emit({
            "ok": True,
            "controls": load()
        })

    if action == "set":
        if len(sys.argv) != 4:
            emit({
                "ok": False,
                "error":
                    "set requires key and true/false"
            }, 2)

        key = sys.argv[2]
        raw = sys.argv[3].strip().lower()

        if key not in DEFAULTS:
            emit({
                "ok": False,
                "error":
                    "unknown notification control"
            }, 3)

        if raw not in {
            "true",
            "false"
        }:
            emit({
                "ok": False,
                "error":
                    "value must be true or false"
            }, 4)

        data = load()
        data[key] = (
            raw == "true"
        )

        save(data)

        emit({
            "ok": True,
            "controls": load()
        })

    emit({
        "ok": False,
        "error": "unsupported action"
    }, 2)


if __name__ == "__main__":
    main()
