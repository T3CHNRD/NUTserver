#!/usr/bin/env python3
# Copyright (c) 2026 T3CHNRD. All rights reserved.
"""
UPS Maintenance Mode suppression check.

Exit codes:
  0 = suppress shutdown commit for this UPS
  1 = do not suppress shutdown commit
  2 = usage or read error
"""

import argparse
import json
import sys
from pathlib import Path

STATE_PATH = Path("/var/www/html/nut-state/ups-maintenance.json")


def main():
    parser = argparse.ArgumentParser(description="Check whether UPS Maintenance Mode suppresses shutdown for a UPS")
    parser.add_argument("--ups", required=True)
    parser.add_argument("--state-file", default=str(STATE_PATH))
    args = parser.parse_args()

    state_file = Path(args.state_file)

    try:
        data = json.loads(state_file.read_text())
    except Exception as exc:
        print(f"SUPPRESS_CHECK_ERROR ups={args.ups} reason=state_unreadable error={exc}")
        return 2

    for item in data.get("active_sessions", []):
        if item.get("ups") == args.ups and item.get("status") in ("active", "warning"):
            print(
                "SUPPRESS_SHUTDOWN "
                f"ups={args.ups} "
                f"started_at={item.get('started_at', '')} "
                f"mode={item.get('mode', '')} "
                f"status={item.get('status', '')}"
            )
            return 0

    print(f"DO_NOT_SUPPRESS ups={args.ups} reason=no_active_maintenance")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
