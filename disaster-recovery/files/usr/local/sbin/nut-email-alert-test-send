#!/usr/bin/env bash
# Copyright (c) 2026 T3CHNRD. All rights reserved.
set -euo pipefail

CONF="/etc/nut/nut-email-alerts.conf"
MSMTP_CONF="/etc/msmtprc"
SMTP_SECRET="[REDACTED]"
LOG="/var/log/nut-orchestrator-ui/ui-actions.log"

usage() {
  cat <<'USAGE'
Usage:
  nut-email-alert-test-send --list
  nut-email-alert-test-send --preview <type>
  nut-email-alert-test-send --send <type>

Types:
  onbatt     Power switched to UPS
  online     Power returned to grid
  shutdown   Protected systems are shutting down
  cancelled  Shutdown cancelled because power returned
  final      NUT server final shutdown warning
  lowbatt    UPS battery has reached low-battery state
  commbad    UPS communication has been lost
  commok     UPS communication has been restored
  weekly     Daily UPS health report
  idf_power  APC IDF2/IDF3 power or input-quality event

This tool sends production-format email content manually.
It does not simulate UPS events.
It does not trigger shutdowns.
It does not change NUT mode.
USAGE
}

ACTION="${1:-}"
TYPE="${2:-}"

case "$ACTION" in
  --list)
    echo "onbatt"
    echo "online"
    echo "shutdown"
    echo "cancelled"
    echo "final"
    echo "lowbatt"
    echo "commbad"
    echo "commok"
    echo "weekly"
    echo "idf_power"
    exit 0
    ;;
  --preview|--send)
    [ -n "$TYPE" ] || { usage; exit 1; }
    ;;
  *)
    usage
    exit 1
    ;;
esac

case "$TYPE" in
  onbatt|online|shutdown|cancelled|final|lowbatt|commbad|commok|weekly|idf_power) ;;
  *)
    echo "FAIL: unknown email type: $TYPE"
    usage
    exit 1
    ;;
esac

[ -f "$CONF" ] || { echo "FAIL: missing $CONF"; exit 1; }

# EARLY DAILY HEALTH EMAIL DELIVERY GATE
#
# This must run before SMTP validation. When the scheduled Daily Health
# Email is intentionally disabled, no SMTP configuration is needed because
# no message will be sent.
if [ "$ACTION" = "--send" ] && [ "$TYPE" = "weekly" ]; then
  if python3 - <<'PYCFG'
import json
from pathlib import Path

path = Path("/etc/nut/config.d/notification-controls.json")

enabled = True

try:
    data = json.loads(path.read_text(encoding="utf-8"))
    value = data.get("daily_health_email", True)

    if isinstance(value, bool):
        enabled = value
    elif isinstance(value, str):
        enabled = value.strip().lower() in {
            "1", "true", "yes", "on"
        }
    else:
        enabled = bool(value)

except Exception:
    enabled = True

raise SystemExit(0 if not enabled else 1)
PYCFG
  then
    echo "Daily Health Email is disabled by notification-controls.json; no email sent."
    exit 0
  fi
fi

if [ "$ACTION" = "--send" ]; then
  # /etc/msmtprc is generated when email configuration is applied.
  #
  # Do NOT rebuild it for every message. UPS event emails run from
  # nut-monitor.service, where ProtectSystem=full intentionally makes
  # /etc read-only except approved NUT paths.
  #
  # Rebuilding /etc/msmtprc here caused event email delivery to fail
  # with EROFS even though the generated SMTP configuration was valid.

  [ -f "$MSMTP_CONF" ] || {
    echo "FAIL: missing generated SMTP configuration: $MSMTP_CONF"
    echo "Run nut-rebuild-msmtp-from-email-config outside the NUT monitor service."
    exit 1
  }

  [ -r "$MSMTP_CONF" ] || {
    echo "FAIL: generated SMTP configuration is not readable: $MSMTP_CONF"
    exit 1
  }

  msm_owner="$(stat -c '%U:%G' "$MSMTP_CONF")"
  msm_mode="$(stat -c '%a' "$MSMTP_CONF")"

  if [ "$msm_owner" != "root:root" ] || [ "$msm_mode" != "600" ]; then
    echo "FAIL: unsafe SMTP configuration ownership or permissions"
    exit 1
  fi

  if [ "$CONF" -nt "$MSMTP_CONF" ]; then
    echo "FAIL: generated SMTP configuration is older than the email configuration"
    echo "Run nut-rebuild-msmtp-from-email-config outside the NUT monitor service."
    exit 1
  fi

  if [ -e "$SMTP_SECRET" ] && [ "$SMTP_SECRET" -nt "$MSMTP_CONF" ]; then
    echo "FAIL: generated SMTP configuration is older than the SMTP secret"
    echo "Run nut-rebuild-msmtp-from-email-config outside the NUT monitor service."
    exit 1
  fi
fi

python3 - "$ACTION" "$TYPE" <<'PY'
import os
from pathlib import Path
from email.message import EmailMessage
from email.utils import formatdate
from datetime import datetime
import shlex
import subprocess
import sys
import socket
import re
import fcntl
import time

action = sys.argv[1]
kind = sys.argv[2]

conf_path = Path("/etc/nut/nut-email-alerts.conf")
log_path = Path("/var/log/nut-orchestrator-ui/ui-actions.log")

data = {}
for raw in conf_path.read_text(encoding="utf-8").splitlines():
    line = raw.strip()
    if not line or line.startswith("#") or "=" not in line:
        continue
    key, value = line.split("=", 1)
    key = key.strip()
    value = value.strip()
    try:
        value = shlex.split(value)[0] if value else ""
    except Exception:
        value = value.strip('"').strip("'")
    data[key] = value

prefix = data.get("EMAIL_SUBJECT_PREFIX", "[NUT Server]")
sender = data.get("EMAIL_FROM", "")
recipients_raw = data.get("EMAIL_RECIPIENTS", "")
recipients = [x.strip() for x in recipients_raw.split(",") if x.strip()]

if not sender:
    raise SystemExit("FAIL: EMAIL_FROM is blank")
if not recipients:
    raise SystemExit("FAIL: EMAIL_RECIPIENTS is blank")

hostname = socket.gethostname()
now = datetime.now().astimezone()
def env_text(name, default):
    value = os.environ.get(name, "").strip()
    return value if value else default

def env_list_lines(name, default_line):
    value = os.environ.get(name, "").strip()
    if not value:
        return [default_line]
    parts = [p.strip() for p in value.replace("\\n", "\n").split("\n") if p.strip()]
    if not parts:
        return [default_line]
    return [p if p.startswith("- ") else f"- {p}" for p in parts]

event_reason_text = env_text("NUT_EMAIL_REASON", "Event source was not supplied")
outage_duration_text = env_text("NUT_OUTAGE_DURATION", "unavailable from current email context")
shutdown_attempted_text = env_text("NUT_SHUTDOWN_ATTEMPTED", "No")
manual_recovery_text = env_text("NUT_MANUAL_RECOVERY_REQUIRED", "No, unless equipment shows issues")
systems_scheduled_lines = env_list_lines("NUT_SYSTEMS_SCHEDULED", "- unavailable from current email context")
systems_down_lines = env_list_lines("NUT_SYSTEMS_SHUT_DOWN", "- None reported")
systems_running_lines = env_list_lines("NUT_SYSTEMS_STILL_RUNNING", "- Protected systems remained online or status is unknown")

idf_source_text = env_text("NUT_IDF_SOURCE", "IDF source unavailable")
idf_ip_text = env_text("NUT_IDF_IP", "IP unavailable")
idf_dns_text = env_text("NUT_IDF_DNS", "DNS unavailable")
idf_severity_text = env_text("NUT_IDF_SEVERITY", "Severity unavailable")
idf_event_time_text = env_text("NUT_IDF_EVENT_TIME", "event time unavailable")
idf_message_text = env_text("NUT_IDF_MESSAGE", "IDF power event details unavailable")
idf_source_path_text = env_text("NUT_IDF_SOURCE_PATH", "source path unavailable")

now_text = now.strftime("%m/%d/%Y %-I:%M:%S %p %Z")

def get_mode_summary():
    try:
        proc = subprocess.run(
            ["/usr/local/sbin/nut-production-status"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=10,
        )
        txt = proc.stdout
        mode = "unknown"
        label = "unknown"
        live = "unknown"
        m = re.search(r'"mode"\s*:\s*"([^"]+)"', txt)
        if m:
            mode = m.group(1)
        m = re.search(r'"mode_label"\s*:\s*"([^"]+)"', txt)
        if m:
            label = m.group(1)
        m = re.search(r'"allow_live_actions"\s*:\s*"([^"]+)"', txt)
        if m:
            live = m.group(1)
        return mode, label, live
    except Exception:
        return "unknown", "unknown", "unknown"

mode, mode_label, live_actions = get_mode_summary()

def enforce_email_mode_policy(action, kind, mode, mode_label):
    """
    Enforce email behavior by NUT protection mode.

    Protecting / armed:
      all configured email types allowed

    Standby / disarmed:
      limited email types only:
        onbatt, online, weekly, idf_power

    Off:
      no emails allowed
    """
    if action != "--send":
        return

    allowed_by_mode = {
        "armed": {
            "onbatt",
            "online",
            "shutdown",
            "cancelled",
            "final",
            "lowbatt",
            "commbad",
            "commok",
            "weekly",
            "idf_power",
        },
        "disarmed": {
            "onbatt",
            "online",
            "lowbatt",
            "commbad",
            "commok",
            "weekly",
            "idf_power",
        },
        "off": set(),
    }

    # Legacy storm_guard is also a PROTECTING mode.
    allowed_by_mode["storm_guard"] = set(
        allowed_by_mode["armed"]
    )

    allowed = allowed_by_mode.get(mode, set())

    if kind in allowed:
        return

    if mode == "off":
        raise SystemExit(
            f"EMAIL BLOCKED BY MODE: mode={mode} label={mode_label!r} "
            f"type={kind} reason='Off mode blocks all emails'"
        )

    if mode == "disarmed":
        raise SystemExit(
            f"EMAIL BLOCKED BY MODE: mode={mode} label={mode_label!r} "
            f"type={kind} reason='Standby allows power, battery, communication, daily health, and IDF power emails'"
        )

    raise SystemExit(
        f"EMAIL BLOCKED BY MODE: mode={mode} label={mode_label!r} "
        f"type={kind} reason='Unknown mode or email type not allowed'"
    )

enforce_email_mode_policy(action, kind, mode, mode_label)

def run(cmd, timeout=10):
    try:
        p = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
        )
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except Exception as e:
        return 1, "", str(e)

def get_ups_names():
    rc, out, err = run(["bash", "-lc", "upsc -l 2>/dev/null"], timeout=10)
    return [x.strip() for x in out.splitlines() if x.strip()]

def get_ups_value(target, key):
    rc, out, err = run(["upsc", target, key], timeout=5)
    if rc == 0 and out:
        return out
    return "not available"



def get_ups_descriptions():
    descriptions = {}
    current = None

    try:
        with open("/etc/nut/ups.conf", "r", encoding="utf-8", errors="replace") as f:
            for raw in f:
                line = raw.strip()

                if line.startswith("[") and line.endswith("]"):
                    current = line.strip("[]").strip()
                    continue

                if current and line.lower().startswith("desc") and "=" in line:
                    value = line.split("=", 1)[1].strip().strip("\"'")
                    descriptions[current] = value
    except Exception:
        pass

    return descriptions


def get_ups_friendly_names(ups_names):
    friendly = {}

    for ups in ups_names:
        try:
            out = subprocess.check_output(
                ["upsc", ups, "ups.id"],
                text=True,
                stderr=subprocess.DEVNULL,
                timeout=8,
            ).strip()
            if out:
                friendly[ups] = out
        except Exception:
            pass

    return friendly



def get_ups_rack_locations():
    rack_map = {}
    path = "/var/www/html/ups-rack-map.txt"

    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for raw in f:
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue

                ups, value = line.split("=", 1)
                ups = ups.strip()
                value = value.strip()

                if ups and value:
                    rack_map[ups] = value
    except Exception:
        pass

    return rack_map



def friendly_ups_label(ups, descriptions, friendly_names=None):
    descriptions = descriptions or {}
    friendly_names = friendly_names or {}

    desc = descriptions.get(ups, "").strip()
    friendly = friendly_names.get(ups, "").strip()

    if desc and friendly:
        return f"{ups} - {desc} - Friendly name: {friendly}"

    if desc:
        return f"{ups} - {desc}"

    if friendly:
        return f"{ups} - Friendly name: {friendly}"

    return ups

def friendly_ups_status(value):
    raw = str(value or "").strip()
    if not raw or raw == "not available":
        return "Unavailable"

    tokens = [REDACTED]
    translated = []
    mapping = {
        "OL": "Online",
        "OB": "On battery",
        "OF": "Offline",
        "LB": "Low battery",
        "RB": "Replace battery",
        "CHRG": "Charging",
        "DISCHRG": "Discharging",
        "BYPASS": "[REDACTED]",
        "CAL": "Calibration",
        "BOOST": "Boost",
        "TRIM": "Trim",
    }

    for token in tokens:
        translated.append(mapping.get(token, token))

    return ", ".join(translated)



def runtime_minutes(value):
    try:
        seconds = float(value)
    except Exception:
        return "Unknown"

    if seconds < 0:
        return "Unknown"

    minutes = int(round(seconds / 60.0))

    if minutes < 60:
        return f"{minutes} minute" + ("" if minutes == 1 else "s")

    hours = minutes // 60
    remaining = minutes % 60

    if remaining == 0:
        return f"{hours} hour" + ("" if hours == 1 else "s")

    return (
        f"{hours} hour" + ("" if hours == 1 else "s") +
        f" {remaining} minute" + ("" if remaining == 1 else "s")
    )

def ping_target(ip):
    rc, out, err = run(["ping", "-c", "3", "-W", "2", ip], timeout=10)
    if rc == 0:
        summary = ""
        for line in out.splitlines():
            if "packets transmitted" in line:
                summary = line.strip()
                break
        return "reachable", summary or "ping successful"
    summary = err.strip() or out.strip() or "ping failed"
    return "not reachable", summary

def latest_idf_event(source):
    log = Path("/var/log/nut-orchestrator-ui/power-events.log")
    if not log.exists():
        return "unknown", "not found", "power event log not found"

    try:
        lines = log.read_bytes().decode("utf-8", errors="replace").replace("\r", "").splitlines()
    except Exception as e:
        return "unknown", "not found", f"could not read power event log: {e}"

    source_key = str(source or "").strip().upper()

    aliases = {
        "IDF2": [
            'source="IDF2"',
            'device="IDF2"',
            'device="APC-IDF2"',
            'ip="192.168.9.251"',
            'dns="APC-IDF2"',
            'dns="APC-IDF2."',
            'dns="APC-IDF2.albl.com"',
        ],
        "IDF3": [
            'source="IDF3"',
            'device="IDF3"',
            'device="APC-IDF3"',
            'ip="192.168.9.252"',
            'dns="apc-idf3"',
            'dns="apc-idf3."',
            'dns="apc-idf3.albl.com"',
        ],
    }.get(source_key, [f'source="{source}"'])

    def is_target_line(line):
        lower = line.lower()
        has_target = any(alias.lower() in lower for alias in aliases)
        has_power_event = (
            "on battery power" in lower or
            "no longer on battery power" in lower
        )
        has_apc_event = "apc_idf_event" in lower or "apc_idf_target_event" in lower
        return has_target and has_power_event and has_apc_event

    matches = [line for line in lines if is_target_line(line)]

    if not matches:
        return "unknown", "not found", "not found"

    last = matches[-1]
    last_lower = last.lower()

    if "no longer on battery power" in last_lower:
        power_source = "line/grid"
    elif "on battery power" in last_lower:
        power_source = "battery"
    else:
        power_source = "unknown"

    event_time = "not found"
    for token in ('event_time="',):
        if token in last:
            event_time = last.split(token, 1)[1].split('"', 1)[0]
            break

    message = last
    if 'message="' in last:
        message = last.split('message="', 1)[1].split('"', 1)[0]
    elif 'status="' in last:
        message = last.split('status="', 1)[1].split('"', 1)[0]

    return power_source, event_time, message

def idf_status_lines():
    targets = [
        ("IDF 2", "IDF2", "192.168.9.251", "APC-IDF2.albl.com"),
        ("IDF 3", "IDF3", "192.168.9.252", "apc-idf3.albl.com"),
    ]

    lines = [
        "IDF reachability and power status:",
    ]

    for label, source, ip, dns in targets:
        reachability, ping_summary = ping_target(ip)
        power_source, event_time, message = latest_idf_event(source)

        lines.append("")
        lines.append(f"- {label}")
        lines.append(f"  IP: {ip}")
        lines.append(f"  DNS: {dns}")
        lines.append(f"  Reachability: {reachability}")
        lines.append(f"  Ping summary: {ping_summary}")
        lines.append(f"  Last known power source: {power_source}")
        lines.append(f"  Last known event time: {event_time}")
        lines.append(f"  Last known event message: {message}")

    return lines


def ups_health_lines():
    ups_names = get_ups_names()
    descriptions = get_ups_descriptions()
    friendly_names = get_ups_friendly_names(ups_names)
    rack_locations = get_ups_rack_locations()
    lines = []
    lines.append("UPS health details:")
    if not ups_names:
        lines.append("- UPS details unavailable from upsc at the time this email was generated.")
        return lines

    for ups in ups_names:
        target = f"{ups}@localhost"
        status = get_ups_value(target, "ups.status")
        charge = get_ups_value(target, "battery.charge")
        runtime = get_ups_value(target, "battery.runtime")
        load = get_ups_value(target, "ups.load")
        battv = get_ups_value(target, "battery.voltage")
        linev = get_ups_value(target, "input.voltage")

        lines.append("")
        lines.append(f"- {friendly_ups_label(ups, descriptions, friendly_names)}")
        if rack_locations.get(ups):
            lines.append(f"  Rack / Location: {rack_locations.get(ups)}")
        lines.append(f"  Status: {friendly_ups_status(status)}")
        lines.append(f"  Battery charge: {charge}%")
        lines.append(f"  Runtime remaining: {runtime_minutes(runtime)}")
        lines.append(f"  Load: {load}%")
        lines.append(f"  Battery voltage: {battv}")
        lines.append(f"  Input voltage: {linev}")
    return lines


def ups_weather_grid_risk_lines():
    import json
    import urllib.request

    lines = []
    blockers = []
    cautions = []
    positives = []

    url = (
        "https://api.open-meteo.com/v1/forecast"
        "?latitude=42.6389&longitude=-83.2910"
        "&current=temperature_2m,weather_code,wind_speed_10m,wind_gusts_10m"
        "&daily=temperature_2m_max,temperature_2m_min,weather_code,precipitation_probability_max,wind_gusts_10m_max"
        "&temperature_unit=fahrenheit"
        "&wind_speed_unit=mph"
        "&timezone=America%2FDetroit"
        "&forecast_days=1"
    )

    severe_codes = {
        95: "Thunderstorm",
        96: "Thunderstorm with hail",
        99: "Severe thunderstorm with hail",
    }

    winter_blocker_codes = {
        57: "Dense freezing drizzle",
        66: "Freezing rain",
        67: "Heavy freezing rain",
        75: "Heavy snow",
        86: "Heavy snow showers",
    }

    winter_caution_codes = {
        56: "Freezing drizzle",
        71: "Slight snow",
        73: "Moderate snow",
        77: "Snow grains",
        85: "Snow showers",
    }

    rain_codes = {
        51, 53, 55,
        61, 63, 65,
        80, 81, 82,
    }

    fair_codes = {0, 1, 2}
    cloudy_codes = {3, 45, 48}

    def as_code(value):
        try:
            return int(value)
        except (TypeError, ValueError):
            return None

    def as_float(value):
        try:
            return float(value)
        except (TypeError, ValueError):
            return None

    def temp_text(value):
        value = as_float(value)
        if value is None:
            return "unavailable"
        return f"{int(round(value))}\u00b0F"

    def matching_description(mapping, current_code, forecast_code):
        if current_code in mapping:
            return mapping[current_code]
        if forecast_code in mapping:
            return mapping[forecast_code]
        return None

    try:
        cache_path = Path("/var/cache/nut/weather-cache.json")

        cached = json.loads(
            cache_path.read_text(encoding="utf-8")
        )

        if not cached.get("ok"):
            raise RuntimeError("weather cache is not marked OK")

        data = cached.get("data")

        if not isinstance(data, dict):
            raise RuntimeError("weather cache contains no usable data")

        weather_source = str(
            cached.get("source") or "Open-Meteo"
        )

        weather_fetched_at = str(
            cached.get("fetched_at") or "unknown"
        )

        current = data.get("current", {})
        daily = data.get("daily", {})

        temp = as_float(current.get("temperature_2m"))
        code = as_code(current.get("weather_code"))

        max_temp = None
        min_temp = None
        max_gust = None
        daily_code = None

        if daily.get("temperature_2m_max"):
            max_temp = as_float(daily["temperature_2m_max"][0])

        if daily.get("temperature_2m_min"):
            min_temp = as_float(daily["temperature_2m_min"][0])

        if daily.get("wind_gusts_10m_max"):
            max_gust = as_float(daily["wind_gusts_10m_max"][0])

        if daily.get("weather_code"):
            daily_code = as_code(daily["weather_code"][0])

        severe = matching_description(
            severe_codes, code, daily_code
        )

        winter_block = matching_description(
            winter_blocker_codes, code, daily_code
        )

        winter_caution = matching_description(
            winter_caution_codes, code, daily_code
        )

        # ---------------------------------------------------------
        # MAINTENANCE RISK RULES
        # ---------------------------------------------------------

        # Severe thunderstorms / hail = BLOCK.
        if severe:
            blockers.append(
                f"Severe storm risk: {severe}."
            )

        # Significant freezing precipitation / heavy snow = BLOCK.
        if winter_block:
            blockers.append(
                f"Significant winter-weather risk: {winter_block}."
            )

        # Lighter snow / freezing drizzle = CAUTION.
        if winter_caution:
            cautions.append(
                f"Winter-weather caution: {winter_caution}."
            )

        # User-approved cold threshold:
        # forecast temperature <= 34 F = BLOCK.
        if min_temp is not None and min_temp <= 34:
            blockers.append(
                f"Cold-weather risk: today's forecast low is "
                f"{int(round(min_temp))}\u00b0F, at or below the "
                f"34\u00b0F maintenance threshold."
            )

        # Heat / grid-load thresholds.
        if max_temp is not None and max_temp >= 90:
            blockers.append(
                f"High heat/grid-load risk: today's forecast high is "
                f"{int(round(max_temp))}\u00b0F."
            )
        elif max_temp is not None and max_temp >= 85:
            cautions.append(
                f"Elevated heat/grid-load caution: today's forecast high is "
                f"{int(round(max_temp))}\u00b0F."
            )

        # Wind thresholds.
        if max_gust is not None and max_gust >= 40:
            blockers.append(
                f"High wind risk: forecast gusts up to "
                f"{int(round(max_gust))} mph."
            )
        elif max_gust is not None and max_gust >= 30:
            cautions.append(
                f"Wind caution: forecast gusts up to "
                f"{int(round(max_gust))} mph."
            )

        # ---------------------------------------------------------
        # PLAIN-ENGLISH WEATHER SUMMARY
        #
        # Rain / drizzle by itself is informational only.
        # It does NOT automatically create CAUTION.
        # ---------------------------------------------------------

        codes = {c for c in (code, daily_code) if c is not None}

        if severe:
            summary = (
                "Stormy today. Thunderstorms are expected or occurring."
            )

        elif winter_block:
            summary = (
                "Snow or ice is expected today. "
                "Winter conditions may make planned UPS maintenance unsafe."
            )

        elif winter_caution:
            summary = (
                "Wintry weather is possible today, with snow or "
                "freezing drizzle."
            )

        elif max_temp is not None and max_temp >= 90:
            summary = (
                "Hot today. High temperatures may increase electrical "
                "grid demand."
            )

        elif max_gust is not None and max_gust >= 40:
            summary = (
                "Very windy today, with strong gusts expected."
            )

        elif max_gust is not None and max_gust >= 30:
            summary = (
                "Windy today, with gusty conditions expected."
            )

        elif codes & rain_codes:
            summary = (
                "Rainy today. No severe weather condition is currently "
                "affecting the maintenance recommendation."
            )

        elif codes & fair_codes:
            summary = (
                "Nice day today. No significant weather or grid-risk "
                "conditions expected."
            )

        elif codes & cloudy_codes:
            summary = (
                "Cloudy today. No significant weather or grid-risk "
                "conditions expected."
            )

        else:
            summary = (
                "No significant weather or grid-risk conditions are "
                "currently expected."
            )

        # These two lines are ALWAYS returned to both health outputs.
        lines.append("Weather / grid-risk advisory:")
        lines.append(
            f"- Source: {weather_source} cached forecast"
        )
        lines.append(
            f"- Forecast cache updated: {weather_fetched_at}"
        )
        lines.append(f"- Current temperature: {temp_text(temp)}")
        lines.append(f"- Weather: {summary}")

        if not blockers and not cautions:
            positives.append(
                "Weather/grid risk is acceptable for planned maintenance "
                "based on the current forecast."
            )

    except Exception:
        lines.append("Weather / grid-risk advisory:")
        lines.append("- Current temperature: unavailable")
        lines.append(
            "- Weather: Weather data is unavailable; verify local "
            "conditions before planned UPS maintenance."
        )

        cautions.append(
            "Weather/grid-risk data could not be retrieved automatically; "
            "verify local conditions before planned UPS maintenance."
        )

    return lines, blockers, cautions, positives


def ups_maintenance_recommendation_lines():
    import json
    import subprocess
    from pathlib import Path

    lines = []
    blockers = []
    cautions = []
    positives = []

    lines.append("UPS maintenance recommendation:")

    ups_names = get_ups_names()
    online_count = 0
    offline = []

    for ups in ups_names:
        status = get_ups_value(f"{ups}@localhost", "ups.status")
        if "OL" in (status or ""):
            online_count += 1
        else:
            offline.append(f"{ups} status={status or 'unknown'}")

    if ups_names and online_count == len(ups_names):
        positives.append(f"All {online_count} monitored UPS units are online.")
    else:
        blockers.append(f"Only {online_count} of {len(ups_names)} monitored UPS units are online.")
        for item in offline:
            blockers.append(item)

    if str(mode_label).upper() == "OFF":
        blockers.append("NUT mode is OFF, so monitoring, logging, and email reports may be disabled.")
    elif str(mode_label).upper() == "PROTECTING":
        positives.append("NUT mode is PROTECTING; normal UPS protection remains active.")
    else:
        positives.append(f"NUT mode is {mode_label}.")

    if str(live_actions) == "0":
        positives.append("Live protection actions are currently blocked.")
    else:
        positives.append("Live protection actions are allowed for qualifying UPS power events.")

    maint_path = Path("/var/www/html/nut-state/ups-maintenance.json")
    try:
        maint = json.loads(maint_path.read_text())
        active = maint.get("active_sessions", [])
        unresolved = maint.get("unresolved_items", [])
        if active or unresolved:
            blockers.append(f"UPS Maintenance Mode has active/unresolved items: active={len(active)}, unresolved={len(unresolved)}.")
        else:
            positives.append("No active or unresolved UPS Maintenance Mode items were found.")
    except Exception as exc:
        blockers.append(f"UPS Maintenance state could not be read: {exc}")

    compare_cmd = "/usr/local/sbin/nut-ups-identity-compare"
    try:
        result = subprocess.run(
            [compare_cmd],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=30,
            check=False,
        )
        if result.returncode == 0:
            positives.append("UPS identity comparison matches the saved baseline.")
        else:
            blockers.append("UPS identity comparison found a mismatch or unreadable UPS.")
            for line in result.stdout.splitlines()[:12]:
                blockers.append(line)
    except Exception as exc:
        blockers.append(f"UPS identity comparison could not run: {exc}")

    for source in ("IDF2", "IDF3"):
        power_source, event_time, message = latest_idf_event(source)
        if power_source == "battery":
            blockers.append(f"{source} last known power source is battery at {event_time}: {message}")
        elif power_source == "line/grid":
            positives.append(f"{source} last known power source is line/grid.")
        else:
            cautions.append(f"{source} last known power source is unknown; last event time: {event_time}.")

    weather_lines, weather_blockers, weather_cautions, weather_positives = ups_weather_grid_risk_lines()
    blockers.extend(weather_blockers)
    cautions.extend(weather_cautions)

    if blockers:
        lines.append("Status: BLOCK - do not begin planned UPS swaps or battery maintenance today.")
        primary_heading = "Primary reason(s) for BLOCK:"
        primary_items = blockers
        primary_prefix = "BLOCK"
    elif cautions:
        lines.append("Status: CAUTION - verify conditions before planned UPS swaps or battery maintenance today.")
        primary_heading = "Primary reason(s) for CAUTION:"
        primary_items = cautions
        primary_prefix = "CAUTION"
    else:
        lines.append("Status: CLEAR - conditions are acceptable for planned UPS or battery maintenance today.")
        primary_heading = "Primary reason(s) for CLEAR:"
        primary_items = ["No blocking or caution conditions were found."]
        primary_prefix = "CLEAR"

    lines.append("")
    lines.append(primary_heading)
    for item in primary_items[:3]:
        lines.append(f"- {primary_prefix}: {item}")
    if len(primary_items) > 3:
        lines.append(f"- {primary_prefix}: Additional items are listed below in Reasons / risk checks.")

    lines.append("")
    lines.append("Weather / grid risk summary:")

    # Always show the concise temperature and layman weather summary.
    for item in weather_lines:
        if item != "Weather / grid-risk advisory:":
            lines.append(item)

    # Add only maintenance-relevant weather risk details.
    for item in weather_blockers[:5]:
        lines.append(f"- BLOCK: {item}")

    for item in weather_cautions[:5]:
        lines.append(f"- CAUTION: {item}")

    lines.append("")

    lines.append("Reasons / risk checks:")
    for item in blockers:
        lines.append(f"- BLOCK: {item}")
    for item in cautions:
        lines.append(f"- CAUTION: {item}")
    for item in positives:
        lines.append(f"- OK: {item}")

    lines.append("")
    lines.append("Reminder: UPS Maintenance Mode can suppress false NUT-triggered shutdowns, but it does not protect equipment from power loss while a UPS or battery is physically disconnected.")
    return lines


def notification_control(name, default=True):
    import json
    from pathlib import Path

    path = Path(
        "/etc/nut/config.d/notification-controls.json"
    )

    try:
        data = json.loads(
            path.read_text()
        )

        value = data.get(
            name,
            default
        )

        if isinstance(value, bool):
            return value

        if isinstance(value, str):
            return value.strip().lower() in {
                "1",
                "true",
                "yes",
                "on",
            }

        return bool(value)

    except Exception:
        return default


def daily_health_closing_thought():
    """
    Routine Daily UPS health email personality only.

    Use the user-facing Weather summary plus actual BLOCK/CAUTION
    reasons so negative phrases such as "no cold-weather risk"
    cannot accidentally select the wrong closing thought.
    """

    try:
        weather_lines, blockers, cautions, positives = (
            ups_weather_grid_risk_lines()
        )

        weather_summary = ""

        for line in weather_lines:
            stripped = str(line).strip()

            if stripped.lower().startswith("weather:"):
                weather_summary = stripped.lower()
                break

        actual_risks = " ".join(
            str(x)
            for x in (blockers + cautions)
        ).lower()

        combined = (
            weather_summary
            + " "
            + actual_risks
        )

        if any(
            phrase in combined
            for phrase in (
                "thunderstorm",
                "stormy",
                "hail",
                "severe storm",
            )
        ):
            return (
                "Storms are expected. Perhaps let nature "
                "handle the bad decisions for today."
            )

        if any(
            phrase in combined
            for phrase in (
                "snow",
                "freezing rain",
                "freezing drizzle",
                "ice",
                "icy",
                "cold today",
                "cold weather",
            )
        ):
            return (
                "It's going to be cold. Dress warmly; "
                "questionable judgment provides surprisingly "
                "little insulation."
            )

        if any(
            phrase in combined
            for phrase in (
                "hot today",
                "high heat",
                "heat/grid-load",
                "elevated heat",
            )
        ):
            return (
                "It's going to be hot. Stay hydrated; "
                "clear thinking already has enough obstacles."
            )

        if any(
            phrase in combined
            for phrase in (
                "windy",
                "high wind",
                "wind caution",
                "strong wind",
            )
        ):
            return (
                "It's going to be windy. Secure anything "
                "outdoors with more stability than your "
                "decision-making."
            )

        if any(
            phrase in weather_summary
            for phrase in (
                "rainy",
                "rain today",
                "drizzle",
            )
        ):
            return (
                "Enjoy the rain. Nature has reviewed your "
                "outdoor plans and declined them."
            )

        return (
            "Have a nice day. Even the weather managed "
            "to meet expectations."
        )

    except Exception:
        return (
            "Have a nice day. The weather declined to "
            "provide enough material for commentary."
        )



UPS_EVENT_TYPES = {
    "onbatt",
    "online",
    "shutdown",
    "cancelled",
    "final",
    "lowbatt",
    "commbad",
    "commok",
}

def event_ups_identity():
    ups_id = os.environ.get("NUT_UPS_ID", "").strip().lower()

    if not ups_id:
        m = re.search(r"\bups[1-9]\b", event_reason_text, re.I)
        if m:
            ups_id = m.group(0).lower()

    if not ups_id:
        return "", "", ""

    rack_location = "Unknown / not mapped"
    rack_map = Path("/var/www/html/ups-rack-map.txt")

    try:
        for raw in rack_map.read_text(encoding="utf-8").splitlines():
            key, sep, value = raw.partition("=")
            if sep and key.strip().lower() == ups_id:
                rack_location = value.strip()
                break
    except Exception:
        pass

    props = {}

    try:
        rc, out, _ = run(
            ["/usr/bin/upsc", f"{ups_id}@localhost"],
            timeout=4
        )

        if rc == 0:
            for raw in out.splitlines():
                key, sep, value = raw.partition(":")
                if sep:
                    props[key.strip()] = value.strip()
    except Exception:
        pass

    friendly_name = (
        props.get("friendly_system_name")
        or props.get("ups.id")
        or props.get("device_model")
        or props.get("device.model")
        or props.get("ups.model")
        or ups_id.upper()
    )

    return ups_id.upper(), friendly_name, rack_location


event_ups_id, event_friendly_name, event_rack_location = (
    event_ups_identity()
)

event_subject_identity = ""

if event_ups_id:
    event_subject_identity = event_ups_id

    if event_rack_location:
        event_subject_identity += f" - {event_rack_location}"

