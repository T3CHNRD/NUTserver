tpl = templates[kind]

if (
    action == "--send"
    and kind == "weekly"
    and not notification_control(
        "daily_health_email",
        True
    )
):
    print(
        "Daily Health Email is disabled by "
        "notification-controls.json; no email sent."
    )
    sys.exit(0)

test_mode = (
    os.environ.get("NUT_EMAIL_TEST", "").strip() == "1"
    or event_reason_text.upper().startswith("TEST ONLY")
)

base_subject = tpl["subject"]

if (
    kind in UPS_EVENT_TYPES
    and event_subject_identity
):
    base_subject = (
        f"{base_subject} - {event_subject_identity}"
    )

if test_mode:
    subject = (
        f"{prefix} [TEST - NO ACTION REQUIRED] "
        f"{base_subject}"
    )
    display_title = f"TEST ONLY - {tpl['title']}"
else:
    subject = f"{prefix} {base_subject}"
    display_title = tpl["title"]

body_lines = [
    display_title,
    "=" * len(display_title),
    "",
]

if test_mode:
    body_lines.extend([
        "THIS IS A CONTROLLED EMAIL TEST.",
        "NO REAL UPS, POWER, BATTERY, OR COMMUNICATION EVENT HAS OCCURRED.",
        "NO ACTION IS REQUIRED.",
        "",
    ])

if kind in UPS_EVENT_TYPES and event_ups_id:
    body_lines.extend([
        "Affected UPS:",
        f"UPS ID: {event_ups_id}",
        f"Friendly name: {event_friendly_name}",
        f"Rack / Location: {event_rack_location}",
        "",
    ])

body_lines.extend([
    f"NUT server: {hostname}",
    f"NUT mode: {mode_label}",
    "",
    *tpl["body"],
])

body = "\n".join(body_lines)

if action == "--preview":
    print("===== EMAIL PREVIEW =====")
    print(f"Type: {kind}")
    print(f"From: {sender}")
    print(f"To: {', '.join(recipients)}")
    print(f"Subject: {subject}")
    print()
    print(body)
    sys.exit(0)

msg = EmailMessage()
msg["From"] = sender
msg["To"] = ", ".join(recipients)
msg["Date"] = formatdate(localtime=True)
msg["Subject"] = subject
msg.set_content(body)

lock_path = Path("/run/nut-email-send.lock")
stamp_path = Path("/run/nut-email-last-send")

with lock_path.open("a+") as lock:
    fcntl.flock(lock.fileno(), fcntl.LOCK_EX)

    # Prevent simultaneous UPS events from exceeding the
    # Exchange client submission-rate limit.
    try:
        last = float(stamp_path.read_text().strip())
    except Exception:
        last = 0.0

    wait = 3.0 - (time.time() - last)
    if wait > 0:
        time.sleep(wait)

    proc = None

    for attempt, delay in enumerate((0, 20, 40), start=1):
        if delay:
            print(
                f"EMAIL TRANSPORT RETRY attempt={attempt} "
                f"delay={delay}s",
                file=sys.stderr,
            )
            time.sleep(delay)

        proc = subprocess.run(
            ["/usr/sbin/sendmail", "-t"],
            input=msg.as_bytes(),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )

        if proc.returncode == 0:
            stamp_path.write_text(str(time.time()))
            break

        # EX_UNAVAILABLE / EX_TEMPFAIL are temporary delivery failures.
        if proc.returncode not in (69, 75):
            break

log_line = f"EMAIL PRODUCTION FORMAT MANUAL SEND type={kind} rc={proc.returncode} subject={subject!r}\n"
with log_path.open("a", encoding="utf-8") as f:
    f.write(log_line)

if proc.stdout:
    print(proc.stdout.decode(errors="replace"))
if proc.stderr:
    print(proc.stderr.decode(errors="replace"), file=sys.stderr)

if proc.returncode != 0:
    raise SystemExit(proc.returncode)

print(f"Sent production-format email type={kind}")
