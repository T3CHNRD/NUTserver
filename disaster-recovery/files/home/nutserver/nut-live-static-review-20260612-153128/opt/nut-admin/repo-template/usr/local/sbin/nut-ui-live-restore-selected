#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-dry-run}"
REQUESTED_ID="${2:-}"
CONFIRMATION="${3:-}"

REPO_DIR="/opt/nut-admin/repo-template"
CATALOG="/etc/nut/restore/restore-targets.json"
TS="$(date +%Y%m%d-%H%M%S)"
BACKUP_ROOT="/var/backups/nut-admin/live-restore"
REQUIRED_CONFIRMATION="RESTORE SELECTED FILE"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

case "$MODE" in
  dry-run|live)
    ;;
  *)
    fail "mode must be dry-run or live"
    ;;
esac

[ -n "$REQUESTED_ID" ] || fail "restore item id is required"
[ -d "$REPO_DIR/.git" ] || fail "$REPO_DIR is not a Git repo"

if [ "$REQUESTED_ID" = "restore_test_probe" ]; then
  CATEGORY="restore-test"
  NAME="Safe test probe"
  REPO_SOURCE="$REPO_DIR/etc/nut/restore-live-test-probe.txt"
  LIVE_PATH="/etc/nut/restore-live-test-probe.txt"
  FILE_MODE="644"
  OWNER="root"
  GROUP="root"
  RESTORE_ENABLED="true"
  BLOCKED_REASON=""
else
  [ -f "$CATALOG" ] || fail "restore target catalog missing: $CATALOG"

  item_json="$(python3 - "$CATALOG" "$REQUESTED_ID" <<'PY'
import json
import sys
from pathlib import Path

catalog_path = Path(sys.argv[1])
requested_id = sys.argv[2]

data = json.loads(catalog_path.read_text())
for item in data.get("targets", []):
    if item.get("id") == requested_id:
        print(json.dumps(item))
        raise SystemExit(0)

raise SystemExit(44)
PY
)" || {
    rc=$?
    if [ "$rc" = "44" ]; then
      fail "restore item id is not in catalog: $REQUESTED_ID"
    fi
    fail "failed reading restore catalog"
  }

  CATEGORY="editable-live-config"
  NAME="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("name",""))' "$item_json")"
  REPO_SOURCE="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("repo_source",""))' "$item_json")"
  LIVE_PATH="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("live_path",""))' "$item_json")"
  FILE_MODE="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("mode","") or "644")' "$item_json")"
  OWNER="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("owner","") or "root")' "$item_json")"
  GROUP="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("group","") or "root")' "$item_json")"
  RESTORE_ENABLED="$(python3 -c 'import json,sys; print(str(json.loads(sys.argv[1]).get("restore_enabled",False)).lower())' "$item_json")"
  BLOCKED_REASON="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("blocked_reason",""))' "$item_json")"
fi

[ -n "$REPO_SOURCE" ] || fail "repo source is empty for restore item: $REQUESTED_ID"
[ -n "$LIVE_PATH" ] || fail "live path is empty for restore item: $REQUESTED_ID"

if [ "$RESTORE_ENABLED" != "true" ]; then
  fail "restore item is blocked: ${BLOCKED_REASON:-unknown reason}"
fi

if [[ "$LIVE_PATH" != /* ]]; then
  fail "live destination must be absolute: $LIVE_PATH"
fi

if [[ "$REPO_SOURCE" != "$REPO_DIR/"* ]]; then
  fail "repo source must be inside $REPO_DIR: $REPO_SOURCE"
fi

BACKUP_PATH="$BACKUP_ROOT/$TS${LIVE_PATH}.pre-restore"

echo "===== SELECTED-FILE LIVE RESTORE ENGINE ====="
echo "mode=$MODE"
echo "restore_item_id=$REQUESTED_ID"
echo "name=$NAME"
echo "category=$CATEGORY"
echo "repo_source=$REPO_SOURCE"
echo "live_destination=$LIVE_PATH"
echo "planned_owner=$OWNER"
echo "planned_group=$GROUP"
echo "planned_mode=$FILE_MODE"
echo "pre_restore_backup=$BACKUP_PATH"
echo

if [ -f "$REPO_SOURCE" ]; then
  echo "repo_source_exists=yes"
else
  echo "repo_source_exists=no"
  fail "repo-backed known-good source is missing: $REPO_SOURCE"
fi

if [ -e "$LIVE_PATH" ]; then
  echo "live_destination_exists=yes"
else
  echo "live_destination_exists=no"
fi

echo
echo "----- RESTORE PLAN -----"
echo "1. Create pre-restore backup if live destination exists"
echo "2. Install repo source to live destination"
echo "3. Set owner ${OWNER}:${GROUP}"
echo "4. Set mode $FILE_MODE"
echo "5. Report completion"
echo

if [ "$MODE" = "dry-run" ]; then
  echo "actual_backup_created=false"
  echo "actual_copy_executed=false"
  echo "actual_chown_executed=false"
  echo "actual_chmod_executed=false"
  echo "actual_service_restart_executed=false"
  echo "result=PASS"
  echo "action=dry_run_only_no_copy"
  exit 0
fi

if [ "$CONFIRMATION" != "$REQUIRED_CONFIRMATION" ]; then
  fail "live restore requires exact confirmation phrase: $REQUIRED_CONFIRMATION"
fi

echo "===== LIVE RESTORE START ====="

if [ -e "$LIVE_PATH" ]; then
  mkdir -p "$(dirname "$BACKUP_PATH")"
  cp -a "$LIVE_PATH" "$BACKUP_PATH"
  echo "actual_backup_created=true"
  echo "backup_path=$BACKUP_PATH"
else
  echo "actual_backup_created=false"
  echo "backup_path="
fi

install -o "$OWNER" -g "$GROUP" -m "$FILE_MODE" "$REPO_SOURCE" "$LIVE_PATH"

echo "actual_copy_executed=true"
echo "actual_chown_executed=true"
echo "actual_chmod_executed=true"
echo "actual_service_restart_executed=false"
echo "result=PASS"
echo "action=live_restore_selected_file_complete"
echo "===== LIVE RESTORE COMPLETE ====="
