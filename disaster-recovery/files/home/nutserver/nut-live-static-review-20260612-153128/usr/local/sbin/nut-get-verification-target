#!/bin/bash
set -u

MAP_FILE="/etc/nut/config.d/shutdown-verification-targets.conf"
TARGET="${1:-}"

if [ -z "$TARGET" ]; then
  echo "Usage: nut-get-verification-target <target_name>" >&2
  exit 64
fi

if [ ! -r "$MAP_FILE" ]; then
  echo "ERROR map file not readable: $MAP_FILE" >&2
  exit 1
fi

awk -F'|' -v target="$TARGET" '
  /^[[:space:]]*#/ { next }
  /^[[:space:]]*$/ { next }
  $1 == target {
    print "TARGET_NAME=\"" $1 "\""
    print "TARGET_IP=\"" $2 "\""
    print "VERIFY_TIMEOUT=\"" $3 "\""
    print "NETWORK_DEPENDENCY=\"" $4 "\""
    print "WRAPPER_PATH=\"" $5 "\""
    print "TARGET_NOTES=\"" $6 "\""
    found=1
  }
  END {
    if (!found) exit 2
  }
' "$MAP_FILE"
