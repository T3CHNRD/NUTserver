# Fill these in only if/when Proxmox hosts exist.
PROXMOX_HOST_01_NAME=CHANGE_ME_HOST_OR_URL
PROXMOX_HOST_01_IP=CHANGE_ME_HOST_OR_URL

PROXMOX_HOST_02_NAME=CHANGE_ME_HOST_OR_URL
PROXMOX_HOST_02_IP=CHANGE_ME_HOST_OR_URL

PROXMOX_HOST_03_NAME=CHANGE_ME_HOST_OR_URL
PROXMOX_HOST_03_IP=CHANGE_ME_HOST_OR_URL

PROXMOX_SHUTDOWN_REASON="power outage"

# Future Proxmox live gate requirements:
