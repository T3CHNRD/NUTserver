[Unit]
Description=NUT Orchestrator UI Flask Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/nut-orchestrator-ui
ExecStart=/usr/bin/gunicorn -w 2 -b 127.0.0.1:5080 app:app
Restart=always
RestartSec=5

# NoNewPrivileges removed because approved sudo wrappers are required for root-owned NUT config access
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/nut-orchestrator-ui /var/lib/nut-orchestrator-ui

[Install]
WantedBy=multi-user.target
