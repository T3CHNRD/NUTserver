# NUT Email Alert Settings
# Managed by NUT server project.
# This file is intended to appear in Editable Live Config.
#
# IMPORTANT:
# - Do not store the SMTP password in this file.
# - The SMTP password/app password belongs in:
#   /etc/nut/nut-email-alerts.secret
#
# Mode email rules:
# - OFF: no emails are sent.
# - STANDBY: power event emails and weekly UPS health email only.
# - PROTECTING: all configured email alerts are sent.

NUT_EMAIL_ENABLED="1"

# SMTP relay settings
NUT_EMAIL_SMTP_HOST="smtp.office365.com"
NUT_EMAIL_SMTP_PORT="587"
NUT_EMAIL_SMTP_TLS="1"
NUT_EMAIL_SMTP_AUTH="1"

# SMTP username / sender
NUT_EMAIL_SMTP_USER="reports@albl.com"
NUT_EMAIL_FROM="reports@albl.com"

# Comma-separated recipient list
NUT_EMAIL_TO="tvedders@albl.com,bsautter@albl.com"

# Optional subject prefix
NUT_EMAIL_SUBJECT_PREFIX="[NUT Server]"

# OFF mode:
# OFF means everything is off, including monitoring/logging behavior as defined by the mode system.
# Email rule: no emails will be sent.
NUT_EMAIL_OFF_ENABLED="0"

# STANDBY mode:
# Monitoring is active, live shutdown/protection actions are blocked.
# Email rule: only power events and weekly UPS health emails are allowed.
NUT_EMAIL_STANDBY_POWER_EVENTS="1"
NUT_EMAIL_STANDBY_UPS_HEALTH="1"
NUT_EMAIL_STANDBY_SHUTDOWN_EVENTS="0"
NUT_EMAIL_STANDBY_FINAL_SHUTDOWN="0"

# PROTECTING mode:
# Monitoring is active, live protection actions are allowed for qualifying UPS events.
# Email rule: all configured alerts are allowed.
NUT_EMAIL_PROTECT_POWER_EVENTS="1"
NUT_EMAIL_PROTECT_UPS_HEALTH="1"
NUT_EMAIL_PROTECT_SHUTDOWN_EVENTS="1"
NUT_EMAIL_PROTECT_FINAL_SHUTDOWN="1"

# Alert labels used by the future email helper.
NUT_EMAIL_ALERT_POWER_TO_UPS="1"
NUT_EMAIL_ALERT_POWER_TO_GRID="1"
NUT_EMAIL_ALERT_SHUTDOWN_STARTED="1"
NUT_EMAIL_ALERT_SHUTDOWN_CANCELED="1"
NUT_EMAIL_ALERT_NUTSERVER_FINAL_SHUTDOWN="1"
NUT_EMAIL_ALERT_WEEKLY_UPS_HEALTH="1"
