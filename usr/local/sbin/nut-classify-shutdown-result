#!/bin/bash
set -u

TARGET_NAME="${1:-}"
COMMAND_RC="${2:-}"
VERIFY_RC="${3:-}"

if [ -z "$TARGET_NAME" ] || [ -z "$COMMAND_RC" ] || [ -z "$VERIFY_RC" ]; then
  echo "Usage: nut-classify-shutdown-result <target_name> <command_rc> <verify_rc>" >&2
  exit 64
fi

case "$COMMAND_RC" in
  ''|*[!0-9]*)
    echo "WARN target=\"$TARGET_NAME\" reason=\"invalid_command_rc\" command_rc=\"$COMMAND_RC\""
    exit 3
    ;;
esac

case "$VERIFY_RC" in
  ''|*[!0-9]*)
    echo "WARN target=\"$TARGET_NAME\" reason=\"invalid_verify_rc\" verify_rc=\"$VERIFY_RC\""
    exit 3
    ;;
esac

if [ "$COMMAND_RC" -ne 0 ]; then
  echo "FAIL target=\"$TARGET_NAME\" reason=\"command_failed\" command_rc=${COMMAND_RC}"
  exit 1
fi

case "$VERIFY_RC" in
  0)
    echo "PASS target=\"$TARGET_NAME\" reason=\"shutdown_confirmed\""
    exit 0
    ;;
  1)
    echo "FAIL target=\"$TARGET_NAME\" reason=\"target_still_online_after_shutdown_attempt\""
    exit 1
    ;;
  2)
    echo "UNKNOWN target=\"$TARGET_NAME\" reason=\"cannot_verify_due_to_network_path\""
    exit 2
    ;;
  64)
    echo "WARN target=\"$TARGET_NAME\" reason=\"verification_usage_error_command_was_sent\""
    exit 3
    ;;
  *)
    echo "WARN target=\"$TARGET_NAME\" reason=\"command_sent_but_not_verified\" verify_rc=${VERIFY_RC}"
    exit 3
    ;;
esac
