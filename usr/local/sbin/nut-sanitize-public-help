#!/usr/bin/env python3

from pathlib import Path
import re
import shutil
import sys

if len(sys.argv) != 4:
    raise SystemExit(
        "usage: nut-sanitize-public-help SOURCE DEST RULES"
    )

src = Path(sys.argv[1])
dst = Path(sys.argv[2])
rules_file = Path(sys.argv[3])

if not src.is_dir():
    raise SystemExit(f"FAIL: source Help missing: {src}")

if not rules_file.is_file():
    raise SystemExit(f"FAIL: redaction rules missing: {rules_file}")

TEMP_MARKERS = (
    ".before-",
    ".pre-",
    ".bak",
    ".backup",
    ".candidate",
    ".working-",
    ".broken-",
    ".disabled-",
    ".final-before-",
    ".save",
    ".tmp",
    ".swp",
)

def is_current_help_file(path):
    if not path.is_file():
        return False

    name = path.name.lower()

    if path.suffix.lower() not in {".md", ".txt"}:
        return False

    if any(marker in name for marker in TEMP_MARKERS):
        return False

    if name.endswith(".pyc"):
        return False

    if "__pycache__" in path.parts:
        return False

    return True

rules = []

for line in rules_file.read_text().splitlines():
    line = line.strip()

    if not line or line.startswith("#"):
        continue

    if "|" not in line:
        raise SystemExit(
            "FAIL: malformed private redaction rule"
        )

    old, new = line.split("|", 1)

    if old:
        rules.append((old, new))

private_ip = re.compile(
    r'(?<![\d.])(?:'
    r'10\.(?:\d{1,3}\.){2}\d{1,3}|'
    r'192\.168\.(?:\d{1,3}\.)\d{1,3}|'
    r'172\.(?:1[6-9]|2\d|3[01])\.(?:\d{1,3}\.)\d{1,3}'
    r')(?![\d.])'
)

email = re.compile(
    r'(?<![\w.+-])'
    r'[A-Za-z0-9._%+-]+@'
    r'[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
)

credential_uri = re.compile(
    r'([A-Za-z][A-Za-z0-9+.-]*://)'
    r'([^/\s:@]+):([^@\s/]+)@'
)

sensitive_assignment = re.compile(
    r'''(?ix)
    ^
    (?P<prefix>
        \s*
        (?:export\s+)?
        [A-Za-z0-9_.-]*
        (?:
            password|
            passwd|
            passphrase|
            token|
            secret|
            api[_-]?key|
            bot[_-]?token|
            chat[_-]?id|
            smtp[_-]?(?:user|username|password)|
            recipient
        )
        [A-Za-z0-9_.-]*
        \s*[:=]\s*
    )
    (?P<value>.+?)
    $
    '''
)

def sanitize(text):
    original = text

    for old, new in rules:
        text = text.replace(old, new)

    text = private_ip.sub("<INTERNAL_IP>", text)

    def email_replacement(match):
        value = match.group(0)

        if value.lower().endswith("@example.com"):
            return value

        if value.lower().endswith("@example.org"):
            return value

        if value.lower().endswith("@example.net"):
            return value

        return "<EMAIL_ADDRESS>"

    text = email.sub(email_replacement, text)

    text = credential_uri.sub(
        r'\1<USERNAME>:<REQUIRED_SECRET>@',
        text
    )

    output = []

    for line in text.splitlines(keepends=True):
        newline = ""

        if line.endswith("\r\n"):
            body = line[:-2]
            newline = "\r\n"
        elif line.endswith("\n"):
            body = line[:-1]
            newline = "\n"
        else:
            body = line

        match = sensitive_assignment.match(body)

        if match:
            value = match.group("value").strip()

            already_safe = (
                "<" in value
                or "example" in value.lower()
                or "replace_me" in value.lower()
                or "required_secret" in value.lower()
                or "redacted" in value.lower()
            )

            if not already_safe:
                body = (
                    match.group("prefix")
                    + "<REDACTED_SITE_VALUE>"
                )

        output.append(body + newline)

    return "".join(output), original

sources = [
    path
    for path in src.rglob("*")
    if is_current_help_file(path)
]

if not sources:
    raise SystemExit("FAIL: no current Help files found")

stage = dst.parent / (dst.name + ".public-stage")

if stage.exists():
    shutil.rmtree(stage)

stage.mkdir(parents=True)

changed = 0

for source in sorted(sources):
    rel = source.relative_to(src)
    target = stage / rel

    text = source.read_text(errors="strict")
    clean, original = sanitize(text)

    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(clean)

    if clean != original:
        changed += 1

if dst.exists():
    shutil.rmtree(dst)

stage.rename(dst)

md_count = len(list(dst.rglob("*.md")))
ref_count = len(list(dst.rglob("REF_*.md")))

print(f"HELP_FILES={len(sources)}")
print(f"HELP_MD={md_count}")
print(f"REF_MD={ref_count}")
print(f"SANITIZED_FILES={changed}")
print("PASS: complete public Help tree generated")
