#!/usr/bin/env python3
# Copyright (c) 2026 T3CHNRD. All rights reserved.

import argparse
import datetime
import json
import os
import tempfile
from pathlib import Path

STATE_PATH = Path("/var/www/html/nut-state/ups-maintenance.json")
LOG_PATH = Path("/var/log/nut-ups-maintenance.log")

VALID_EVENTS = {
    "UPS_MAINTENANCE_FOUNDATION_CREATED",
    "UPS_MAINTENANCE_STARTED",
    "UPS_MAINTENANCE_UPS_OFFLINE",
    "UPS_MAINTENANCE_UPS_RETURNED",
    "UPS_MAINTENANCE_TIMEOUT_WARNING",
    "UPS_MAINTENANCE_TIMEOUT_EXPIRED",
    "UPS_MAINTENANCE_REPLACEMENT_DETECTED",
    "UPS_MAINTENANCE_COMPLETED",
    "UPS_MAINTENANCE_REAL_OUTAGE_DETECTED",
    "UPS_MAINTENANCE_CONSOLIDATION_REVIEW_REQUIRED",
    "UPS_MAINTENANCE_REMOVAL_REVIEW_REQUIRED",
    "UPS_MAINTENANCE_RETIREMENT_COMPLETED",
    "UPS_MAINTENANCE_NOTE",
}

def now_iso():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")

def load_state():
    if STATE_PATH.exists():
        data = json.loads(STATE_PATH.read_text() or "{}")
        if not isinstance(data, dict):
            raise SystemExit("State file is not a JSON object")
    else:
        data = {}

    data.setdefault("schema_version", 1)
    data.setdefault("feature", "UPS Maintenance Mode")
    data.setdefault("implemented_phase", "phase2-state-writer-helper")
    data.setdefault("status", "initialized")
    data.setdefault("active_sessions", [])
    data.setdefault("unresolved_items", [])
    data.setdefault("recent_records", [])
    data.setdefault("created_at", now_iso())
    data.setdefault("updated_at", now_iso())
    return data

def write_state(data):
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".ups-maintenance.", dir=str(STATE_PATH.parent))
    with os.fdopen(fd, "w") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, STATE_PATH)
    os.chown(STATE_PATH, 0, 124)
    os.chmod(STATE_PATH, 0o664)

def append_log(record):
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    line = (
        f"{record['timestamp']} {record['event']} "
        f"ups={record.get('ups') or '-'} "
        f"mode={record.get('mode') or '-'} "
        f"message={record.get('message') or ''}"
    )
    with LOG_PATH.open("a") as fh:
        fh.write(line.rstrip() + "\n")

def main():
    parser = argparse.ArgumentParser(description="Record a UPS Maintenance Mode event")
    parser.add_argument("--event", required=True, choices=sorted(VALID_EVENTS))
    parser.add_argument("--ups", default="")
    parser.add_argument("--mode", default="")
    parser.add_argument("--status", default="")
    parser.add_argument("--operator", default="")
    parser.add_argument("--message", default="")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    state = load_state()
    record = {
        "timestamp": now_iso(),
        "event": args.event,
        "ups": args.ups,
        "mode": args.mode,
        "status": args.status,
        "operator": args.operator,
        "message": args.message,
    }

    records = state.setdefault("recent_records", [])
    records.append(record)
    del records[:-200]

    state["implemented_phase"] = "phase2-state-writer-helper"
    state["status"] = args.status or state.get("status", "initialized")
    state["updated_at"] = record["timestamp"]

    write_state(state)
    append_log(record)

    if args.json:
        print(json.dumps(state, indent=2))
    else:
        print(f"PASS recorded {args.event}")

if __name__ == "__main__":
    main()
