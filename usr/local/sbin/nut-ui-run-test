#!/usr/bin/env bash
set -uo pipefail

LOG_FILE="/var/log/nut-orchestrator-ui/tests.log"
POWER_EVENT_LOG="/var/log/nut-orchestrator-ui/power-events.log"
REGISTRY="/opt/nut-orchestrator-ui/lib/config_registry.json"
MODE="${1:-simulate}"

PASS_COUNT=0
FAIL_COUNT=0

mkdir -p "$(dirname "$LOG_FILE")"
touch "$LOG_FILE" "$POWER_EVENT_LOG"

ts() { date -Is; }

log_line() {
  echo "[$(ts)] $1" | tee -a "$LOG_FILE"
}

power_event() {
  echo "[$(ts)] $1" | tee -a "$POWER_EVENT_LOG" >> "$LOG_FILE"
}

pass() {
  PASS_COUNT=$((PASS_COUNT + 1))
  log_line "PASS $1"
}

fail() {
  FAIL_COUNT=$((FAIL_COUNT + 1))
  log_line "FAIL $1"
}

check_file() {
  [ -e "$1" ] && pass "$2 ($1)" || fail "$2 missing ($1)"
}

check_exec() {
  [ -x "$1" ] && pass "$2 executable ($1)" || fail "$2 not executable ($1)"
}

validate_managed_configs() {
  while IFS=$'\t' read -r id path name; do
    if [ ! -f "$path" ]; then
      fail "Managed config missing for ${id} (${path})"
      continue
    fi

    tmp="$(mktemp)"
    cp -f "$path" "$tmp"

    if /usr/local/sbin/nut-ui-apply-config "$id" "$tmp" dry-run >> "$LOG_FILE" 2>&1; then
      pass "Validated managed config ${id} (${name})"
    else
      fail "Validation failed for ${id} (${name})"
    fi

    rm -f "$tmp"
  done < <(jq -r '.editable_configs[] | [.id, .path, .name] | @tsv' "$REGISTRY")
}

run_prechecks() {
  check_file "$REGISTRY" "Config registry exists"
  check_exec "/usr/local/sbin/nut-ui-apply-config" "Apply wrapper"
  check_exec "/usr/local/sbin/nut-ui-run-test" "Test runner"

  check_file "/etc/nut/hosts.conf" "hosts.conf exists"
  check_file "/etc/nut/nut-orchestrator.conf" "Live orchestrator config exists"
  check_file "/etc/nut/config.d/nut-orchestrator.conf" "config.d orchestrator config exists"
  check_file "/etc/nut/config.d/approved-targets.yml" "Approved targets config exists"
  check_file "/etc/nut/config.d/dashboard-ui.json" "Dashboard UI settings config exists"
  check_file "/var/www/html/nutserver-dashboard.priority1.html" "Priority dashboard exists"

  command -v jq >/dev/null && pass "jq is available" || fail "jq is missing"
  command -v python3 >/dev/null && pass "python3 is available" || fail "python3 is missing"

  validate_managed_configs
}

# =========================
# SIMULATED TEST
# =========================

run_simulate() {
  log_line "TEST START mode=simulate"
  log_line "NOTE Simulated Test does not perform real shutdowns."
  power_event "SIMULATED TEST START mode=simulate"

  run_prechecks

  log_line ""
  log_line "===== SIMULATED SHUTDOWN PLAN ====="

  # ===== VMware (EXPANDED OUTPUT) =====
  log_line ""
  log_line "===== VMWARE ORCHESTRATION ====="
  log_line ""

  if SIMULATE=1 /usr/local/sbin/nut-vmware-shutdown.sh shutdown_domain >> "$LOG_FILE" 2>&1; then
    pass "VMware orchestration simulation"
  else
    fail "VMware orchestration simulation"
  fi

  log_line ""
  log_line "===== VMWARE VCSA DETECT ====="
  log_line ""

  if SIMULATE=1 /usr/local/sbin/nut-vmware-shutdown.sh detect_vcsa_host >> "$LOG_FILE" 2>&1; then
    pass "VMware VCSA host-detect simulation"
  else
    fail "VMware VCSA host-detect simulation"
  fi

  # ===== Other systems =====
  run_sim_wrapper "NetApp01" /usr/local/sbin/nut-netapp-halt.sh Alblnetapp01
  run_sim_wrapper "NetApp02" /usr/local/sbin/nut-netapp-halt.sh Alblnetapp02
  run_sim_wrapper "Synology" /usr/local/sbin/nut-synology-shutdown.sh
  run_sim_wrapper "VOIP" /usr/local/sbin/nut-voip-shutdown.sh
  run_sim_wrapper "DB01" /usr/local/sbin/nut-db-shutdown.sh DB01
  run_sim_wrapper "DB02" /usr/local/sbin/nut-db-shutdown.sh DB02
  run_sim_wrapper "Blue Iris" /usr/local/sbin/nut-blueiris-shutdown.sh
  run_sim_wrapper "Lansweeper" /usr/local/sbin/nut-lansweeper-shutdown.sh

  if [ "$FAIL_COUNT" -eq 0 ]; then
    log_line ""
    log_line "SUMMARY PASS passes=${PASS_COUNT} failures=${FAIL_COUNT}"
    power_event "SIMULATED TEST SUMMARY result=PASS passes=${PASS_COUNT} failures=${FAIL_COUNT}"
    /usr/local/sbin/nut-publish-power-events-json >/dev/null 2>&1 || true
    exit 0
  else
    log_line ""
    log_line "SUMMARY FAIL passes=${PASS_COUNT} failures=${FAIL_COUNT}"
    power_event "SIMULATED TEST SUMMARY result=FAIL passes=${PASS_COUNT} failures=${FAIL_COUNT}"
    /usr/local/sbin/nut-publish-power-events-json >/dev/null 2>&1 || true
    exit 1
  fi
}

# =========================
# REAL TEST (PROTECTED)
# =========================

run_real() {
  log_line "TEST START mode=real"
  power_event "REAL TEST REQUESTED"

  if [ "${ALLOW_REAL_TEST:-0}" != "1" ]; then
    log_line "FAIL Real Test blocked. Set ALLOW_REAL_TEST=1 to enable."
    power_event "REAL TEST BLOCKED"
    exit 1
  fi

  log_line "WARNING REAL TEST ENABLED"
  power_event "REAL TEST START"

  run_prechecks

  log_line ""
  log_line "===== REAL SHUTDOWN TEST PLAN ====="

  # VMware (same expansion)
  if /usr/local/sbin/nut-vmware-shutdown.sh shutdown_domain >> "$LOG_FILE" 2>&1; then
    pass "VMware orchestration execution"
  else
    fail "VMware orchestration execution"
  fi

  # Remaining systems
  run_real_wrapper "NetApp01" /usr/local/sbin/nut-netapp-halt.sh Alblnetapp01
  run_real_wrapper "NetApp02" /usr/local/sbin/nut-netapp-halt.sh Alblnetapp02
  run_real_wrapper "Synology" /usr/local/sbin/nut-synology-shutdown.sh
  run_real_wrapper "VOIP" /usr/local/sbin/nut-voip-shutdown.sh
  run_real_wrapper "DB01" /usr/local/sbin/nut-db-shutdown.sh DB01
  run_real_wrapper "DB02" /usr/local/sbin/nut-db-shutdown.sh DB02
  run_real_wrapper "Blue Iris" /usr/local/sbin/nut-blueiris-shutdown.sh
  run_real_wrapper "Lansweeper" /usr/local/sbin/nut-lansweeper-shutdown.sh

  if [ "$FAIL_COUNT" -eq 0 ]; then
    log_line ""
    log_line "SUMMARY PASS passes=${PASS_COUNT} failures=${FAIL_COUNT}"
    power_event "REAL TEST SUMMARY PASS"
    exit 0
  else
    log_line ""
    log_line "SUMMARY FAIL passes=${PASS_COUNT} failures=${FAIL_COUNT}"
    power_event "REAL TEST SUMMARY FAIL"
    exit 1
  fi
}

case "$MODE" in
  simulate) run_simulate ;;
  real) run_real ;;
  *) echo "Unknown mode: $MODE"; exit 1 ;;
esac
