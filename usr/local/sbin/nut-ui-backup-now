#!/usr/bin/env bash
set -euo pipefail

LOG_FILE="/var/log/nut-orchestrator-ui/backup.log"
BACKUP_SCRIPT="/home/nutserver/nut-run-backup-and-push.sh"

mkdir -p "$(dirname "$LOG_FILE")"

echo "[$(date -Is)] BUTTON-PROOF: nut-ui-backup-now entered" | tee -a "$LOG_FILE"
echo "[$(date -Is)] BACKUP START" | tee -a "$LOG_FILE"

if [ ! -x "$BACKUP_SCRIPT" ]; then
  echo "Backup script not found or not executable: $BACKUP_SCRIPT" | tee -a "$LOG_FILE"
  exit 1
fi

"$BACKUP_SCRIPT" 2>&1 | tee -a "$LOG_FILE"

echo "[$(date -Is)] BACKUP END" | tee -a "$LOG_FILE"
