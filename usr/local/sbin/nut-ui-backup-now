#!/usr/bin/env bash
set -Eeuo pipefail

LOG_FILE="/var/log/nut-orchestrator-ui/backup.log"
BACKUP_SCRIPT="/usr/local/sbin/nut-run-backup-and-push.sh"

mkdir -p "$(dirname "$LOG_FILE")"
touch "$LOG_FILE"

echo "[$(date -Is)] BUTTON-PROOF: nut-ui-backup-now entered" | tee -a "$LOG_FILE"
echo "[$(date -Is)] BACKUP START" | tee -a "$LOG_FILE"

if [ ! -f "$BACKUP_SCRIPT" ]; then
  echo "Backup script not found: $BACKUP_SCRIPT" | tee -a "$LOG_FILE"
  exit 1
fi

if [ ! -x "$BACKUP_SCRIPT" ]; then
  echo "Backup script is not executable: $BACKUP_SCRIPT" | tee -a "$LOG_FILE"
  exit 1
fi

"$BACKUP_SCRIPT"
RC=$?

echo "[$(date -Is)] BACKUP END rc=$RC" | tee -a "$LOG_FILE"
exit "$RC"
