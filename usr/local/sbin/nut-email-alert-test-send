tpl = templates[kind]

test_mode = os.environ.get("NUT_EMAIL_TEST", "").strip() == "1"

if test_mode:
    subject = f"{prefix} [TEST - NO ACTION REQUIRED] {tpl['subject']}"
    display_title = f"TEST ONLY - {tpl['title']}"
else:
    subject = f"{prefix} {tpl['subject']}"
    display_title = tpl["title"]

body_lines = [
    display_title,
    "=" * len(display_title),
    "",
]

if test_mode:
    body_lines.extend([
        "THIS IS A CONTROLLED EMAIL TEST.",
        "NO REAL UPS, POWER, BATTERY, OR COMMUNICATION EVENT HAS OCCURRED.",
        "NO ACTION IS REQUIRED.",
        "",
    ])

body_lines.extend([
    f"NUT server: {hostname}",
    f"NUT mode: {mode_label}",
    "",
    *tpl["body"],
])

body = "\n".join(body_lines)

if action == "--preview":
    print("===== EMAIL PREVIEW =====")
    print(f"Type: {kind}")
    print(f"From: {sender}")
    print(f"To: {', '.join(recipients)}")
    print(f"Subject: {subject}")
    print()
    print(body)
    sys.exit(0)

msg = EmailMessage()
msg["From"] = sender
msg["To"] = ", ".join(recipients)
msg["Date"] = formatdate(localtime=True)
msg["Subject"] = subject
msg.set_content(body)

proc = subprocess.run(
    ["/usr/sbin/sendmail", "-t"],
    input=msg.as_bytes(),
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
)

log_line = f"EMAIL PRODUCTION FORMAT MANUAL SEND type={kind} rc={proc.returncode} subject={subject!r}\n"
with log_path.open("a", encoding="utf-8") as f:
    f.write(log_line)

if proc.stdout:
    print(proc.stdout.decode(errors="replace"))
if proc.stderr:
    print(proc.stderr.decode(errors="replace"), file=sys.stderr)

if proc.returncode != 0:
    raise SystemExit(proc.returncode)

print(f"Sent production-format email type={kind}")
