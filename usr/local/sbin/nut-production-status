#!/usr/bin/env python3
import datetime
import json
import pathlib
import subprocess

MODE_FILE = pathlib.Path("/etc/nut/production-mode.conf")
HYPERVISOR_FILE = pathlib.Path("/etc/nut/hypervisors/hypervisor-ssh-fallback.conf")
STATE_DIR = pathlib.Path("/var/www/html/nut-state")
JSON_OUT = STATE_DIR / "production-mode.json"
TEXT_OUT = pathlib.Path("/var/log/nut-production-mode-status.txt")

VALID_MODES = {
    "off": "OFF",
    "disarmed": "DISARMED",
    "storm_guard": "STORM GUARD",
    "armed": "ARMED",
}


def run(cmd):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=8)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except Exception as exc:
        return 99, "", str(exc)


def parse_kv_file(path):
    data = {}
    if not path.exists():
        return data

    for line in path.read_text(errors="replace").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        data[key.strip()] = value.strip().strip('"').strip("'")
    return data


def systemctl_active(service):
    rc, out, err = run(["systemctl", "is-active", service])
    return out.strip() if out.strip() else "unknown"


def get_ups_statuses():
    rc, out, err = run(["upsc", "-l"])
    ups_names = []
    for line in out.splitlines():
        line = line.strip()
        if not line or line.startswith("Init SSL"):
            continue
        ups_names.append(line)

    ups_items = []
    for ups in ups_names:
        rc, out, err = run(["upsc", ups, "ups.status"])
        status = out.splitlines()[-1].strip() if out.strip() else "UNKNOWN"
        ups_items.append({
            "name": ups,
            "status": status,
            "online": "OL" in status.split(),
        })
    return ups_items


STATE_DIR.mkdir(parents=True, exist_ok=True)

mode_data = parse_kv_file(MODE_FILE)
hypervisor_data = parse_kv_file(HYPERVISOR_FILE)

nut_server = systemctl_active("nut-server.service")
nut_monitor = systemctl_active("nut-monitor.service")
nut_ui = systemctl_active("nut-orchestrator-ui.service")

configured_mode = mode_data.get("NUT_PRODUCTION_MODE", "disarmed").strip().lower()

# OFF is forced if nut-monitor is not active, regardless of file setting.
if nut_monitor != "active":
    mode = "off"
else:
    mode = configured_mode if configured_mode in VALID_MODES else "disarmed"

ups = get_ups_statuses()
ups_total = len(ups)
ups_online = sum(1 for item in ups if item["online"])

payload = {
    "generated_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
    "mode": mode,
    "mode_label": VALID_MODES.get(mode, "DISARMED"),
    "valid_modes": VALID_MODES,
    "nut_server": nut_server,
    "nut_monitor": nut_monitor,
    "nut_ui": nut_ui,
    "ups_total": ups_total,
    "ups_online": ups_online,
    "ups": ups,
    "esxi_ssh_access": "verified_read_only",
    "esxi_ssh_fallback_enabled": hypervisor_data.get("HYPERVISOR_SSH_FALLBACK_ENABLED", "unknown"),
    "esxi_ssh_key": hypervisor_data.get("HYPERVISOR_SSH_KEY", "unknown"),
    "allow_live_actions": mode_data.get("NUT_ALLOW_LIVE_ACTIONS", "unknown"),
    "allow_esxi_ssh_fallback": mode_data.get("NUT_ALLOW_ESXI_SSH_FALLBACK", "unknown"),
    "live_shutdown_test_completed": "no",
    "note": mode_data.get("NUT_MODE_NOTE", ""),
}

JSON_OUT.write_text(json.dumps(payload, indent=2) + "\n")

TEXT_OUT.write_text(
    "\n".join([
        f"generated_at={payload['generated_at']}",
        f"mode={payload['mode_label']}",
        f"nut_monitor={payload['nut_monitor']}",
        f"ups_online={payload['ups_online']}/{payload['ups_total']}",
        f"esxi_ssh_fallback_enabled={payload['esxi_ssh_fallback_enabled']}",
        f"allow_live_actions={payload['allow_live_actions']}",
        f"note={payload['note']}",
        "",
    ])
)

print(json.dumps(payload, indent=2))
